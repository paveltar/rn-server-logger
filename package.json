{
  "name": "rn-server-logger",
  "version": "2.1.0",
  "description": "A React-Native module for tracking server traffic, present it in-app and export it (designed for Harel testers)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "jest",
    "prepublishOnly": "yarn typecheck && yarn test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paveltar/rn-server-logger"
  },
  "author": "OrelAsper",
  "license": "MIT",
  "peerDependencies": {
    "axios": ">=0.27.0",
    "react": ">=18",
    "react-native": "*",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-shake": ">=6.10.0",
    "react-native-share": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-share": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/babel-preset": "0.83.10",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.0.0",
    "axios": "^1.20.0",
    "axios-0.27": "npm:axios@0.27.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "5.10.0",
    "react-native-shake": "6.10.0",
    "react-native-share": "12.3.1",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.9.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "axios 1.x",
        "preset": "react-native",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/dist/"
        ]
      },
      {
        "displayName": "axios 0.27",
        "preset": "react-native",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/dist/"
        ],
        "moduleNameMapper": {
          "^axios$": "axios-0.27"
        }
      }
    ]
  }
}

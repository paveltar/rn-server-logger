{
  "name": "rn-server-logger",
  "version": "2.0.0",
  "description": "A React-Native module for tracking server traffic, present it in-app and export it (designed for Harel testers)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "jest",
    "prepublishOnly": "yarn typecheck && yarn test && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/orel-asper/rn-server-logger"
  },
  "author": "OrelAsper",
  "license": "MIT",
  "peerDependencies": {
    "axios": ">=0.27.0",
    "react": ">=18",
    "react-native": "*",
    "react-native-shake": ">=5.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "axios": "^1.20.0",
    "babel-jest": "^29.2.1",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.73.7",
    "react": "18.2.0",
    "react-native": "0.71.3",
    "react-native-shake": "5.1.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^4.9.5"
  },
  "jest": {
    "preset": "react-native",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
